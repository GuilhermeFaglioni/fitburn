generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Module {
  USUARIOS
  PERFIS_DE_ACESSO
  DASHBOARD
  TEMPLATES_DE_AULA
  OCORRENCIAS
  RESERVAS
  CLIENTES
  PLANOS
  PRESENCA
  FICHAS_DE_TREINO
  GAMIFICACAO
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXECUTE
}

enum PermissionScope {
  ALL
  ASSIGNED_CLIENTS
  ASSIGNED_CLASSES
  OWN
}

model AccessProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  /// Perfil inativo não concede nenhuma permissão (ver PermissionsService) —
  /// não é só um rótulo cosmético na listagem.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  moduleAccess ProfileModuleAccess[]

  @@map("access_profiles")
}

/// Uma linha por (perfil, módulo): as ações concedidas e o escopo de dados
/// nesse módulo. Perfil Administrador não precisa de linhas aqui — o motor
/// de autorização sempre libera tudo para ele (ver PermissionsService).
model ProfileModuleAccess {
  id      String            @id @default(uuid())
  module  Module
  actions PermissionAction[]
  scope   PermissionScope

  profileId String
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, module])
  @@map("profile_module_access")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  /// Opcionais no banco: o admin inicial do seed (T4) não tem esses dados.
  /// Obrigatoriedade é decidida por fluxo na validação (zod) — cadastro de
  /// cliente exige todos, cadastro de equipe não.
  phone        String?
  birthDate    DateTime?
  document     String?    @unique
  address      String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profileId String
  profile   AccessProfile @relation(fields: [profileId], references: [id])

  refreshTokens RefreshToken[]

  defaultForTemplates ClassTemplate[]
  taughtOccurrences   ClassOccurrence[]
  reservations        Reservation[]

  @@map("users")
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
}

model Modality {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates   ClassTemplate[]
  occurrences ClassOccurrence[]

  @@map("modalities")
}

model ClassTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  durationMinutes Int
  capacity        Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modalityId String
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  defaultInstructorId String?
  defaultInstructor   User?   @relation(fields: [defaultInstructorId], references: [id], onDelete: SetNull)

  occurrences ClassOccurrence[]

  @@index([modalityId])
  @@map("class_templates")
}

/// Aula concreta na agenda. Guarda uma cópia dos dados do template no
/// momento da criação — editar o template não altera ocorrências existentes.
/// Duas ocorrências não canceladas nunca se sobrepõem (espaço exclusivo):
/// garantido pela exclusion constraint "class_occurrences_no_overlap",
/// criada à mão na migration (o Prisma não modela EXCLUDE).
model ClassOccurrence {
  id              String           @id @default(uuid())
  name            String
  description     String?
  startsAt        DateTime         @db.Timestamptz(3)
  endsAt          DateTime         @db.Timestamptz(3)
  durationMinutes Int
  capacity        Int
  status          OccurrenceStatus @default(SCHEDULED)
  /// Liga as ocorrências geradas por uma mesma criação recorrente (só rastreabilidade).
  seriesId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  templateId String
  template   ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  modalityId String
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  instructorId String?
  instructor   User?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  reservations Reservation[]

  @@index([startsAt])
  @@index([instructorId])
  @@map("class_occurrences")
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Compromisso de um cliente com uma ocorrência. Criada só pelo motor de
/// reserva (ReservationsService), que revalida a disponibilidade numa
/// transação com lock. Última linha de defesa contra reserva duplicada: o
/// índice único parcial "reservations_client_occurrence_confirmed_key"
/// (cliente, ocorrência) WHERE status = 'CONFIRMED', criado à mão na
/// migration (o Prisma não modela índice parcial).
model Reservation {
  id          String            @id @default(uuid())
  status      ReservationStatus @default(CONFIRMED)
  cancelledAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  occurrenceId String
  occurrence   ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([occurrenceId, status])
  @@map("reservations")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
