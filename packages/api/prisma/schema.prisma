generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Module {
  USUARIOS
  PERFIS_DE_ACESSO
  DASHBOARD
  TEMPLATES_DE_AULA
  OCORRENCIAS
  RESERVAS
  CLIENTES
  PLANOS
  PRESENCA
  FICHAS_DE_TREINO
  GAMIFICACAO
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXECUTE
}

enum PermissionScope {
  ALL
  ASSIGNED_CLIENTS
  ASSIGNED_CLASSES
  OWN
}

model AccessProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  /// Perfil inativo não concede nenhuma permissão (ver PermissionsService) —
  /// não é só um rótulo cosmético na listagem.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  moduleAccess ProfileModuleAccess[]

  @@map("access_profiles")
}

/// Uma linha por (perfil, módulo): as ações concedidas e o escopo de dados
/// nesse módulo. Perfil Administrador não precisa de linhas aqui — o motor
/// de autorização sempre libera tudo para ele (ver PermissionsService).
model ProfileModuleAccess {
  id      String            @id @default(uuid())
  module  Module
  actions PermissionAction[]
  scope   PermissionScope

  profileId String
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, module])
  @@map("profile_module_access")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  /// Opcionais no banco: o admin inicial do seed (T4) não tem esses dados.
  /// Obrigatoriedade é decidida por fluxo na validação (zod) — cadastro de
  /// cliente exige todos, cadastro de equipe não.
  phone        String?
  birthDate    DateTime?
  document     String?    @unique
  address      String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profileId String
  profile   AccessProfile @relation(fields: [profileId], references: [id])

  refreshTokens RefreshToken[]

  defaultForTemplates ClassTemplate[]
  taughtOccurrences   ClassOccurrence[]
  reservations        Reservation[]
  idempotencyRecords  IdempotencyRecord[]
  pointsEntries       PointsEntry[]
  streakBadges        StreakBadge[]
  /// Clientes atribuídos a este usuário como professor (atribuição manual).
  teacherAssignments  TeacherClientAssignment[] @relation("TeacherAssignments")
  /// Professores a quem este usuário, cliente, foi atribuído.
  clientAssignments   TeacherClientAssignment[] @relation("ClientAssignments")

  @@map("users")
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
}

model Modality {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates   ClassTemplate[]
  occurrences ClassOccurrence[]

  @@map("modalities")
}

model ClassTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  durationMinutes Int
  capacity        Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modalityId String
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  defaultInstructorId String?
  defaultInstructor   User?   @relation(fields: [defaultInstructorId], references: [id], onDelete: SetNull)

  occurrences ClassOccurrence[]

  @@index([modalityId])
  @@map("class_templates")
}

/// Aula concreta na agenda. Guarda uma cópia dos dados do template no
/// momento da criação — editar o template não altera ocorrências existentes.
/// Duas ocorrências não canceladas nunca se sobrepõem (espaço exclusivo):
/// garantido pela exclusion constraint "class_occurrences_no_overlap",
/// criada à mão na migration (o Prisma não modela EXCLUDE).
model ClassOccurrence {
  id              String           @id @default(uuid())
  name            String
  description     String?
  startsAt        DateTime         @db.Timestamptz(3)
  endsAt          DateTime         @db.Timestamptz(3)
  durationMinutes Int
  capacity        Int
  status          OccurrenceStatus @default(SCHEDULED)
  /// Liga as ocorrências geradas por uma mesma criação recorrente (só rastreabilidade).
  seriesId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  templateId String
  template   ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  modalityId String
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  instructorId String?
  instructor   User?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  reservations Reservation[]

  @@index([startsAt])
  @@index([instructorId])
  @@map("class_occurrences")
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Compromisso de um cliente com uma ocorrência. Criada só pelo motor de
/// reserva (ReservationsService), que revalida a disponibilidade numa
/// transação com lock. Última linha de defesa contra reserva duplicada: o
/// índice único parcial "reservations_client_occurrence_confirmed_key"
/// (cliente, ocorrência) WHERE status = 'CONFIRMED', criado à mão na
/// migration (o Prisma não modela índice parcial).
model Reservation {
  id          String            @id @default(uuid())
  status      ReservationStatus @default(CONFIRMED)
  cancelledAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  occurrenceId String
  occurrence   ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  pointsEntries PointsEntry[]

  @@index([clientId, status])
  @@index([occurrenceId, status])
  @@map("reservations")
}

/// Resultado memorizado de uma solicitação com `Idempotency-Key`: a mesma
/// intenção repetida devolve o resultado original (inclusive recusas) em vez
/// de agir de novo. Gravado na mesma transação da operação.
model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  /// sha256 da operação + corpo da requisição: a chave reutilizada para
  /// outra intenção é recusada (IDEMPOTENCY_KEY_REUSED).
  fingerprint  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@map("idempotency_records")
}

enum GamificationRuleKind {
  ATTENDANCE_POINTS
  GOAL_POINTS
  STREAK_MILESTONE
}

/// Regras de pontuação em configuração (criadas pelo seed, ajustáveis no banco):
/// o cálculo lê estas linhas e não tem número fixo no código. `threshold` só
/// vale em STREAK_MILESTONE (quantas presenças consecutivas ativam o bônus:
/// 3, 5, 10); nos demais é 0 — 0 e não NULL para o índice único valer.
model GamificationRule {
  id        String                @id @default(uuid())
  kind      GamificationRuleKind
  threshold Int                   @default(0)
  points    Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([kind, threshold])
  @@map("gamification_rules")
}

enum PointsEntryType {
  ATTENDANCE
  GOAL
  STREAK_BONUS
  REVERSAL
}

/// Ledger de pontos: cada ganho (ou estorno, com pontos negativos) é um
/// lançamento; o total do cliente é a soma. Nunca se apaga nem se edita um
/// lançamento — uma correção lança o estorno. `occurredAt` é a data do evento
/// que gerou os pontos (a aula, a meta), a base dos rankings por período.
model PointsEntry {
  id         String          @id @default(uuid())
  type       PointsEntryType
  points     Int
  occurredAt DateTime        @db.Timestamptz(3)
  createdAt  DateTime        @default(now())
  /// Ordem de lançamento: desempata lançamentos do mesmo instante — a
  /// presença e o bônus de streak que ela desperta nascem na mesma
  /// transação, com createdAt igual.
  sequence   Int             @default(autoincrement())
  /// Marco de streak a que o lançamento se refere (3, 5, 10 …): o de um
  /// STREAK_BONUS e o do REVERSAL que o desfaz.
  milestone  Int?

  /// Só em REVERSAL: o lançamento que este estorno desfaz. Um lançamento é
  /// estornado no máximo uma vez; "vivo" é o que nenhum estorno desfez.
  reversesEntryId String?      @unique
  reversesEntry   PointsEntry? @relation("EntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      PointsEntry? @relation("EntryReversal")

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Origem do lançamento quando vem de uma presença (presença, bônus de
  /// streak e estorno); metas apontam para a meta (issue de metas).
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([clientId, occurredAt])
  @@index([reservationId])
  @@map("points_entries")
}

/// Badge de um marco de streak: um por cliente e marco, concedido na primeira
/// vez que uma sequência de presenças o atinge (o bônus de pontos, ao
/// contrário, se repete a cada nova sequência). Uma correção de presença que
/// desfaz todas as sequências que alcançavam o marco o revoga (`revokedAt`);
/// a linha fica, e uma nova sequência o reativa.
model StreakBadge {
  id        String    @id @default(uuid())
  milestone Int
  /// Quando o marco foi atingido (o início da aula que completou a sequência).
  awardedAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now())

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([clientId, milestone])
  @@map("streak_badges")
}

/// Atribuição manual de um cliente a um professor, feita pela administração:
/// junto dos clientes com reserva nas aulas do professor, forma o escopo
/// "clientes atribuídos". É estado atual, não histórico: remover apaga a linha.
model TeacherClientAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  teacherId String
  teacher   User   @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([teacherId, clientId])
  @@index([clientId])
  @@map("teacher_client_assignments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
