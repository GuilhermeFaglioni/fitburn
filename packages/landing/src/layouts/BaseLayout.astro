---
import dmSans700 from "@fontsource/dm-sans/files/dm-sans-latin-700-normal.woff2?url";
import "../styles/base.css";
import { faq } from "../content/faq";
import { site } from "../content/site";
import { env } from "../lib/env";
import { faqJsonLd, gymJsonLd, jsonLdString } from "../lib/schema";

interface Props {
  /** Página sem indexação mesmo com PUBLIC_INDEXABLE=true (404). */
  forceNoindex?: boolean;
  /** Só a home leva JSON-LD. */
  jsonLd?: boolean;
  title?: string;
}
const { forceNoindex = false, jsonLd = true, title = site.meta.title } = Astro.props;
const siteUrl = env.siteUrl;
const noindex = forceNoindex || !env.indexable;
const umamiHost = new URL(siteUrl).host;
---

<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.meta.description} />
    <link rel="canonical" href={`${siteUrl}/`} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/flame.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={dmSans700} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.meta.ogTitle} />
    <meta property="og:description" content={site.meta.ogDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdString(gymJsonLd(site, siteUrl))} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdString(faqJsonLd(faq))} />}
    {
      env.analytics && (
        <script is:inline defer src={env.umamiSrc} data-website-id={env.umamiWebsiteId} data-domains={umamiHost} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
