---
import { ui } from "../content/copy";
---

<a class="logo" href="#inicio" aria-label={ui.logoLabel}>
  <svg class="flame" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
    <path class="flame-a" transform="rotate(-8 210 270)" d="M210,100 C312.5,156.7 305,383.3 210,440 C115,383.3 107.5,156.7 210,100 Z"></path>
    <path class="flame-b" transform="rotate(7 300 250)" d="M300,70 C436.5,132 392.5,368 300,430 C207.5,368 163.5,132 300,70 Z"></path>
  </svg>
  <span class="wordmark" aria-hidden="true">FITBURN</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--s-12);
    color: var(--ink);
    text-decoration: none;
  }
  .flame {
    width: var(--s-8);
    height: var(--s-8);
  }
  .flame-a {
    fill: var(--flame);
  }
  .flame-b {
    fill: var(--brand);
  }
  .wordmark {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    letter-spacing: 0.24em;
  }
</style>
