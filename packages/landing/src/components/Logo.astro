---
interface Props {
  href?: string;
}
const { href = "#inicio" } = Astro.props;
---

<a class="logo" href={href} aria-label="Fitburn Brasil, início">
  <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false">
    <path
      fill="#c23a1f"
      transform="rotate(-8 210 270)"
      d="M210,100 C312.5,156.7 305,383.3 210,440 C115,383.3 107.5,156.7 210,100 Z"></path>
    <path
      fill="#ed6e34"
      transform="rotate(7 300 250)"
      d="M300,70 C436.5,132 392.5,368 300,430 C207.5,368 163.5,132 300,70 Z"></path>
  </svg>
  <span aria-hidden="true">FITBURN</span>
</a>
