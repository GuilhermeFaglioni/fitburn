---
import { actionBar } from "../content/copy";
import { site } from "../content/site";
import CtaLink from "./CtaLink.astro";
---

<nav class="bar" aria-label={actionBar.label}>
  <CtaLink kind="whatsapp" message={site.messages.trial} local="barra" class="btn">{actionBar.whatsapp}</CtaLink>
  <CtaLink kind="tel" variant="secondary" local="barra" class="btn">{actionBar.phone}</CtaLink>
</nav>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    height: calc(var(--action-bar-h) + env(safe-area-inset-bottom));
    padding: var(--s-3) var(--landing-gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .bar :global(.btn) {
    min-height: 0;
    height: 100%;
  }
  @media (min-width: 900px) {
    .bar {
      display: none;
    }
  }
</style>
