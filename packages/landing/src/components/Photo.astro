---
import { Picture } from "astro:assets";
import { photoFor } from "../lib/photos";

interface Props {
  slot: "hero" | "modalidade" | "estrutura-1" | "estrutura-2" | "estrutura-3" | "estrutura-4";
  /** Descreve a cena. Nunca diz que é o estúdio Fitburn (L15). */
  alt: string;
  sizes: string;
  eager?: boolean;
}
const { slot, alt, sizes, eager = false } = Astro.props;
const image = photoFor(slot);
const shape = slot.startsWith("estrutura") ? "square" : slot;
---

<div class:list={["photo", `photo--${shape}`]}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[480, 768, 1080, 1600]}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding={eager ? "sync" : "async"}
        class="photo-img"
      />
    ) : (
      <div class="placeholder" aria-hidden="true" data-photo-placeholder={slot}>
        Foto
      </div>
    )
  }
</div>

<style>
  .photo {
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .photo--hero {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
  }
  .photo--modalidade {
    aspect-ratio: 3 / 2;
  }
  .photo--square {
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 1024px) {
    .photo--hero {
      aspect-ratio: 5 / 6;
    }
  }
  .photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--muted);
    font-size: var(--text-small);
  }
</style>
