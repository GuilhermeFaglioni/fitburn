---
// Foto ilustrativa (L15), em preto e branco por CSS. As imagens vêm de src/assets/photos/<slot>.jpg
// (fonte e licença de cada uma em CREDITS.md). Não são fotos da academia.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  slot: string;
  variant?: "hero" | "wide" | "square";
  /** Descrição da cena que a foto mostra, nunca "Fitburn" (L15). */
  alt: string;
  eager?: boolean;
}
const { slot, variant = "square", alt, eager = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.jpg", { eager: true });
const image = images[`../assets/photos/${slot}.jpg`]?.default;
if (!image) throw new Error(`Foto do slot "${slot}" não encontrada em src/assets/photos`);

const widths = variant === "hero" ? [480, 720, 960] : variant === "wide" ? [480, 720, 960] : [240, 360, 480];
const sizes =
  variant === "hero"
    ? "(min-width: 1024px) 480px, 100vw"
    : variant === "wide"
      ? "(min-width: 1024px) 560px, 100vw"
      : "(min-width: 900px) 25vw, 50vw";
---

<div class={`photo photo--${variant}`} data-slot={slot}>
  <Picture
    src={image}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    width={widths[widths.length - 1]}
    widths={widths}
    sizes={sizes}
    quality={38}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : undefined}
  />
</div>
