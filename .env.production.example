# Variáveis da stack de produção/demonstração (docker-compose.prod.yml), na VPS.
# Copie para `.env.production` (ignorado pelo git) e preencha. NUNCA versione o arquivo preenchido.
# Runbook: docs/deploy-runbook.md.
#
# Os campos deixados VAZIOS abaixo são obrigatórios: o Compose recusa subir sem eles e a API
# recusa iniciar com segredo ausente, de exemplo ou fraco (packages/api/src/config/app-config.ts).
# Gerar segredos:  openssl rand -hex 32
# Use senhas só com letras e números (ex.: hex) para não quebrar a DATABASE_URL montada no Compose.

# --- Domínio e HTTPS (D-031: domínio ainda a definir) -------------------------------------------
# Domínio/subdomínio da API, com o registro DNS (A) já apontado para o IP da VPS. Ex.: api.seudominio.com.br
DOMAIN=
# E-mail do Let's Encrypt (avisos de expiração do certificado).
LETSENCRYPT_EMAIL=

# --- PostgreSQL (só na rede interna do Compose; sem porta publicada) ----------------------------
POSTGRES_USER=fitburn
POSTGRES_DB=fitburn
POSTGRES_PASSWORD=
# A DATABASE_URL da API é montada pelo Compose a partir dos três valores acima:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?schema=public

# --- Autenticação -------------------------------------------------------------------------------
# Mínimo 32 caracteres, nunca o valor de exemplo do .env.example.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Administrador inicial (criado pelo seed / reset da demo) -----------------------------------
INITIAL_ADMIN_EMAIL=
# Mínimo 12 caracteres, nunca a senha de exemplo do .env.example.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Administrador Fitburn"

# --- Segurança de produção (Fase 7) -------------------------------------------------------------
# Origens autorizadas a chamar a API de outro domínio. Deixe VAZIO: com o rewrite /api da Vercel,
# web e API ficam no mesmo site e nenhuma origem cruzada é necessária.
CORS_ALLOWED_ORIGINS=
# Quantos proxies ficam entre o cliente e a API, para o rate limit do login enxergar o IP real:
#   2 = Vercel (rewrite) + Nginx  -> padrão desta stack
#   1 = Nginx apenas (cliente chamando o backend direto, ex.: verificação local sem Vercel)
# Atenção: com 2, quem chamar o backend direto (sem passar pela Vercel) consegue forjar o IP
# via X-Forwarded-For e driblar o limite por IP. Aceito para a demo.
TRUST_PROXY_HOPS=2
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Outros -------------------------------------------------------------------------------------
TZ=UTC
# Tag da imagem da API (útil para voltar a uma versão anterior manualmente).
IMAGE_TAG=latest

# --- Reset da demonstração (issue #50) ----------------------------------------------------------
# O comando `pnpm demo:reset` só roda com a flag de ambiente de demonstração ativa. O nome exato da
# flag e da confirmação são definidos pelo comando de reset: veja a seção "Reset da demonstração"
# do runbook e adicione aqui o que ele exigir. NUNCA ative em um banco que não seja a demo.
