# Postgres (docker compose up -d postgres)
DATABASE_URL="postgresql://fitburn:fitburn@localhost:5432/fitburn_dev?schema=public"
DATABASE_URL_TEST="postgresql://fitburn:fitburn@localhost:5432/fitburn_test?schema=public"

# Auth (Fase 1)
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="7"

# Admin inicial (seed)
INITIAL_ADMIN_EMAIL="admin@fitburn.local"
INITIAL_ADMIN_PASSWORD="TrocarEssaSenha123!"
INITIAL_ADMIN_NAME="Administrador Fitburn"

# Segurança de produção. As travas valem para QUALQUER NODE_ENV que não seja explicitamente
# "development" ou "test" (ausente, "prod", "staging"... contam como produção): use "production".
# Em produção a API RECUSA INICIAR se faltar ou estiver inseguro: JWT_ACCESS_SECRET (mín. 32
# caracteres, nunca o valor de exemplo; gere com `openssl rand -hex 32`), DATABASE_URL,
# INITIAL_ADMIN_EMAIL, INITIAL_ADMIN_PASSWORD (mín. 12 caracteres, nunca a de exemplo) e
# INITIAL_ADMIN_NAME. Em produção o cookie de refresh é HttpOnly + Secure + SameSite=Lax e a API
# envia headers de segurança (helmet, HSTS) e nunca devolve stack/detalhes internos nos erros.
#
# Origens (separadas por vírgula, sem barra final) autorizadas a chamar a API de outro domínio.
# Vazio em produção = nenhuma origem cruzada (app e API atrás do mesmo Nginx). Fora de produção
# vazio = qualquer origem (dev server do Vite).
CORS_ALLOWED_ORIGINS=""
# Rate limit por IP só em POST /api/auth/login, contando apenas tentativas que FALHAM (logins
# bem-sucedidos não consomem a cota; o refresh não é limitado). Sempre ligado em produção;
# fora dela só com AUTH_RATE_LIMIT_ENABLED="true". Padrão: 10 falhas por 60 segundos.
# AUTH_RATE_LIMIT_ENABLED="false"
# AUTH_RATE_LIMIT_MAX="10"
# AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
# Quantos proxies reversos (Nginx) ficam na frente da API; define de onde vem o IP do cliente
# (X-Forwarded-For). Padrão: 1 em produção, 0 fora dela. Use 0 se a API for exposta direto.
# TRUST_PROXY_HOPS="1"

# Reset da demonstração (comando técnico, fora do servidor HTTP; não existe endpoint nem botão).
# `pnpm demo:reset --confirm-database=<nome do banco da DATABASE_URL>` APAGA TODOS OS DADOS,
# aplica as migrations e refaz os seeds (admin inicial a partir de INITIAL_ADMIN_*, perfis de
# sistema, permissões e regras de gamificação). Só roda com a flag abaixo igual a "true" (outro
# valor recusa) e com a confirmação explícita: o nome do banco em --confirm-database ou, em
# terminal interativo, digitado quando pedido. Recusa se o nome não bater com a DATABASE_URL e,
# em produção, reaplica a validação de configuração acima. Deixe a flag desligada por padrão;
# ligue-a só no ambiente de demonstração, no momento de resetar.
# DEMO_RESET_ENABLED="true"

NODE_ENV="development"
PORT="3333"
TZ="UTC"
