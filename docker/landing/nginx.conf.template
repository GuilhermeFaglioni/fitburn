# Servidor da landing estática atrás do proxy do Coolify (Traefik, que termina o TLS).
# Renderizado pelo envsubst da imagem oficial do nginx; só ANALYTICS_ORIGIN e ROBOTS_TAG são substituídas
# (NGINX_ENVSUBST_FILTER), o resto ($uri etc.) fica intacto.
server_tokens off;

# ROBOTS_TAG vazio = sem o header X-Robots-Tag (site no ar no domínio da Fitburn).
map $uri $landing_robots {
    default "${ROBOTS_TAG}";
}

server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml;
    gzip_min_length 512;

    error_page 404 /404.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Arquivos com hash no nome: cache longo.
    location /_astro/ {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' ${ANALYTICS_ORIGIN}; connect-src 'self' ${ANALYTICS_ORIGIN}; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com" always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header X-Robots-Tag $landing_robots always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Imagens e ícones sem hash no nome: um dia.
    location ~* ^/(og\.png|flame\.svg|apple-touch-icon\.png)$ {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' ${ANALYTICS_ORIGIN}; connect-src 'self' ${ANALYTICS_ORIGIN}; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com" always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header X-Robots-Tag $landing_robots always;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # HTML, robots.txt e sitemap: sempre revalidados.
    location / {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' ${ANALYTICS_ORIGIN}; connect-src 'self' ${ANALYTICS_ORIGIN}; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com" always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header X-Robots-Tag $landing_robots always;
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html $uri/index.html =404;
    }
}
